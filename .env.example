# ==============================================================================
# ENVIRONMENT VARIABLES - UNDANGAN NIKAHAN DIGITAL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# [WAJIB] Public URL dari aplikasi Next.js di production (tanpa trailing slash)
NEXT_PUBLIC_APP_URL=https://undanganku.app

# [OPSIONAL] Node environment (development | production | test). Default: development
NODE_ENV=production


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# [WAJIB] Connection string PostgreSQL utama (Pooler connection string jika Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:5432/undangan_db?pgbouncer=true"

# [OPSIONAL/REKOMENDASI] Direct connection string tanpa connection pooler (khusus Supabase/Neon untuk Prisma migration)
DIRECT_URL="postgresql://user:password@host:5432/undangan_db"


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION CONFIGURATION (NextAuth.js)
# ------------------------------------------------------------------------------
# [WAJIB] Random secret key untuk enkripsi session JWT. Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-32-chars-minimum

# [WAJIB] Canonical URL aplikasi untuk NextAuth callback & redirect
NEXTAUTH_URL=https://undanganku.app

# [OPSIONAL] Google OAuth Credentials (jika mengaktifkan fitur Login with Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE (Cloudflare R2 / AWS S3 Compatible)
# ------------------------------------------------------------------------------
# [OPSIONAL] Endpoint S3/R2 API. Jika diisi "mock" atau kosong, sistem menggunakan fallback local storage.
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# [OPSIONAL] Access Key ID & Secret Access Key dari Cloudflare R2 / S3
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key

# [OPSIONAL] Nama Bucket Object Storage
STORAGE_BUCKET_NAME=undangan-media

# [OPSIONAL] Domain CDN Publik untuk akses file media (tanpa trailing slash)
STORAGE_PUBLIC_CDN_URL=https://cdn.undanganku.app


# ------------------------------------------------------------------------------
# 5. BACKGROUND JOB & REDIS (BullMQ Worker)
# ------------------------------------------------------------------------------
# [OPSIONAL] Connection string Redis untuk BullMQ queue kompresi media. Default: redis://localhost:6379
REDIS_URL=redis://default:password@redis-host:6379


# ------------------------------------------------------------------------------
# 6. UPLOAD LIMITS & CONSTRAINTS (Dipakai Validasi FE & BE)
# ------------------------------------------------------------------------------
# [OPSIONAL] Batas ukuran foto (dalam MB). Default: 5
MAX_PHOTO_SIZE_MB=5

# [OPSIONAL] Batas ukuran video (dalam MB). Default: 100
MAX_VIDEO_SIZE_MB=100

# [OPSIONAL] Batas ukuran audio (dalam MB). Default: 10
MAX_AUDIO_SIZE_MB=10

# [OPSIONAL] Batas durasi video (dalam detik). Default: 60
MAX_VIDEO_DURATION_SEC=60

# [OPSIONAL] Batas durasi audio (dalam detik). Default: 300
MAX_AUDIO_DURATION_SEC=300
